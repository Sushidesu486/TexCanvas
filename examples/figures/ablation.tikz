% Ablation study: bar chart of accuracy across model variants.
\begin{tikzpicture}
\begin{axis}[
  ybar, width=7.2cm, height=5cm,
  ylabel={Accuracy}, ylabel style={font=\small},
  symbolic x coords={Baseline,+Attn,+FFN,+Both},
  xtick=data, nodes near coords,
  nodes near coords style={font=\scriptsize},
  bar width=10pt, ymin=0, ymax=1.0,
  tick label style={font=\scriptsize},
  enlarge x limits=0.2,
]
\addplot[fill=blue!40, draw=blue!60] coordinates {
  (Baseline,0.72) (+Attn,0.81) (+FFN,0.78) (+Both,0.91)
};
\end{axis}
\end{tikzpicture}
