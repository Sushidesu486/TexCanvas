% Confusion matrix heatmap for a 4-class classifier.
\begin{tikzpicture}
\begin{axis}[
  width=6cm, height=6cm,
  xlabel={Predicted}, ylabel={True},
  label style={font=\small}, tick label style={font=\scriptsize},
  xtick={0.5,1.5,2.5,3.5}, xticklabels={Cat,Dog,Bird,Fish},
  ytick={0.5,1.5,2.5,3.5}, yticklabels={Cat,Dog,Bird,Fish},
  enlargelimits=false, axis on top,
  point meta min=0, point meta max=100,
  colormap/viridis, colorbar, colorbar style={font=\scriptsize},
]
\addplot[matrix plot, mesh/cols=4, point meta=explicit]
table[meta=C] {
x y C
0 0 90
1 0 5
2 0 3
3 0 2

0 1 4
1 1 85
2 1 8
3 1 3

0 2 6
1 2 10
2 2 78
3 2 6

0 3 2
1 3 4
2 3 6
3 3 88
};
\end{axis}
\end{tikzpicture}
