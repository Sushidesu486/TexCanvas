% Training pipeline overview: data -> model -> loss -> optimizer -> checkpoint.
\begin{tikzpicture}[
  node distance=8mm and 12mm,
  stage/.style={draw, rounded corners=2pt, minimum width=26mm, minimum height=12mm, align=center, fill=blue!8, font=\small},
  data/.style={stage, fill=gray!12},
  loss/.style={stage, fill=orange!15},
  opt/.style={stage, fill=teal!15},
  arrow/.style={-Latex, thick},
  loop/.style={->, thick, dashed, gray!70}
]
  \node[data] (d)   {Dataset\\\texttt{DataLoader}};
  \node[stage, right=of d]  (m) {Model\\$f_\theta$};
  \node[loss, right=of m]   (l) {Loss\\$\mathcal{L}(\hat{y},y)$};
  \node[opt,  right=of l]   (o) {Optimizer\\SGD/Adam};
  \node[data, below=12mm of o] (c) {Checkpoint\\\texttt{.pt}};

  \draw[arrow] (d) -- (m) node[midway, above, font=\scriptsize] {batch};
  \draw[arrow] (m) -- (l) node[midway, above, font=\scriptsize] {forward};
  \draw[arrow] (l) -- (o) node[midway, above, font=\scriptsize] {backward};
  \draw[arrow] (o) -- (c) node[midway, right, font=\scriptsize] {save};

  \draw[loop] (o.south west) ++(-6mm,4mm) -- ++(-3.4,0) |- (m.west);
\end{tikzpicture}
